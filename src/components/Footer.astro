<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div class="brand">
        <h2 class="brand-title">APPOPLOO</h2>
        <span class="brand-sub">EST. 2016</span>
      </div>
      <div class="surgical-line accent-line"></div>
    </div>

    <div class="footer-grid">
      <div class="col">
        <span class="label">Headquarters</span>
        <p class="text-body">
          Stadiou Str. 26 504<br />
          Platani Rio, Greece
        </p>
      </div>

      <div class="col">
        <span class="label">Contact</span>
        <div class="links">
          <a href="/contact" class="link">Enquire Online</a>
          <a href="mailto:info@appoploo.com" class="link">info@appoploo.com</a>
          <a href="tel:+302616008286" class="link">+30 2616 008286</a>
        </div>
      </div>

      <div class="col">
        <span class="label">Legal</span>
        <div class="links">
          <a href="#" class="link">Privacy Policy</a>
          <a href="#" class="link">Terms of Service</a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span class="copyright">© {new Date().getFullYear()} APPOPLOO</span>
      <span class="tagline">INTEGRATED MARITIME SOLUTIONS</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding: 10rem 0 3rem;
    background: var(--primary);
    border-top: 1px solid var(--border);
    overflow: hidden;
  }

  /* Top Section */
  .footer-top {
    margin-bottom: 6rem;
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .brand-title {
    font-size: clamp(3rem, 10vw, 8rem);
    font-family: "Playfair Display", serif;
    color: var(--white);
    line-height: 0.8;
    letter-spacing: -0.04em;
    opacity: 0.15;
  }

  .brand-sub {
    font-family: "Inter", sans-serif;
    font-size: 0.9rem;
    letter-spacing: 0.3em;
    font-weight: 700;
    color: var(--accent);
  }

  .surgical-line {
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, var(--accent), transparent);
    opacity: 0.3;
  }

  /* Grid */
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4rem;
    margin-bottom: 8rem;
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
    font-family: "Inter", sans-serif;
  }

  .text-body {
    font-size: 1rem;
    color: var(--white);
    line-height: 1.6;
  }

  .links {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .link {
    color: var(--white);
    position: relative;
    width: fit-content;
  }

  .link::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--accent);
    transition: width 0.3s ease;
  }

  .link:hover {
    color: var(--accent);
  }

  .link:hover::after {
    width: 100%;
  }

  /* Bottom */
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  .tagline {
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .brand {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 1rem;
      align-items: flex-start;
    }
  }
</style>
