---
const links = {
  company: [
    { name: "About", href: "/" },
    { name: "Services", href: "/#services" },
    { name: "Products", href: "/#products" },
    { name: "Research", href: "/#research" },
  ],
  legal: [
    { name: "Privacy Policy", href: "/privacy-policy" },
    { name: "Terms of Service", href: "/terms-of-use" },
  ],
};

const socials = [
  {
    name: "LinkedIn",
    href: "https://www.linkedin.com/company/appoploo",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
  {
    name: "Facebook",
    href: "https://www.facebook.com/appoploo",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>`,
  },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer-main">
      <div class="footer-brand">
        <a href="/" class="brand-logo">
          <img
            src="/viber_image_2026-02-03_14-08-23-767.png"
            alt="Appoploo Logo"
            class="logo-img"
          />
          <span class="logo-text">APPOPLOO</span>
        </a>
        <p class="brand-tagline">Integrated Maritime Intelligence Solutions</p>
        <div class="brand-socials">
          {
            socials.map((social) => (
              <a
                href={social.href}
                class="social-link"
                aria-label={social.name}
                target="_blank"
                rel="noopener noreferrer"
                set:html={social.icon}
              />
            ))
          }
        </div>
      </div>

      <div class="footer-links">
        <div class="links-group">
          <h4 class="group-title">Company</h4>
          <nav class="group-nav">
            {
              links.company.map((link) => (
                <a href={link.href} class="nav-link">
                  {link.name}
                </a>
              ))
            }
          </nav>
        </div>

        <div class="links-group">
          <h4 class="group-title">Legal</h4>
          <nav class="group-nav">
            {
              links.legal.map((link) => (
                <a href={link.href} class="nav-link">
                  {link.name}
                </a>
              ))
            }
          </nav>
        </div>

        <div class="links-group">
          <h4 class="group-title">Contact</h4>
          <nav class="group-nav">
            <a href="mailto:info@appoploo.com" class="nav-link"
              >info@appoploo.com</a
            >
            <a href="tel:+302616008286" class="nav-link">+30 2616 008286</a>
            <span class="nav-text"
              >Stadiou Str. 26 504<br />Platani Rio, Greece</span
            >
          </nav>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span class="copyright">
        © {new Date().getFullYear()} Appoploo. All rights reserved.
      </span>
      <span class="made-in"> Made in Greece </span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--primary);
    padding-top: 5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-main {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 4rem;
    padding-bottom: 4rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  /* Brand */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .logo-img {
    height: 48px;
    width: auto;
    object-fit: contain;
  }

  .logo-text {
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: 0.05em;
  }

  .brand-tagline {
    font-size: 0.9375rem;
    color: var(--text-tertiary);
    max-width: 280px;
    line-height: 1.6;
  }

  .brand-socials {
    display: flex;
    gap: 0.75rem;
  }

  .social-link {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    color: #ffffff;
    opacity: 0.8;
    transition: all 0.3s ease;
  }

  .social-link:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    opacity: 1;
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.3);
  }

  /* Links */
  .footer-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .group-title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-tertiary);
    margin-bottom: 1.25rem;
  }

  .group-nav {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .nav-link {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    transition: color 0.2s var(--ease-out);
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-text {
    font-size: 0.9375rem;
    color: var(--text-tertiary);
    line-height: 1.6;
  }

  /* Bottom */
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 0;
  }

  .copyright {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
  }

  .made-in {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
  }

  @media (max-width: 900px) {
    .footer-main {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .footer-links {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .footer-links {
      grid-template-columns: 1fr;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 0.75rem;
      text-align: center;
    }
  }
</style>
