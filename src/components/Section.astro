---
const {
  title,
  subtitle,
  image,
  id,
  reverse = false,
  glass = false,
} = Astro.props;
---

<section id={id} class:list={["reveal-section", { reverse }]}>
  <div class="container grid">
    <div class="content">
      <div class="content-header">
        <h2 class="section-title">{title}</h2>
        <div class="surgical-line accent-line"></div>
      </div>
      <p class="section-subtitle text-muted">{subtitle}</p>
      <div class="section-body">
        <slot />
      </div>
    </div>

    <div class="image-wrapper">
      <div class="image-frame">
        <div class="image-container">
          <img
            src={image}
            alt={title}
            class:list={[{ glass }]}
            loading="lazy"
          />
          <div class="image-overlay"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 6rem; /* Tighter gap */
    align-items: center;
  }

  .reveal-section {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .reveal-section.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .reveal-section.reverse .grid {
    direction: rtl;
  }

  .reveal-section.reverse .content {
    direction: ltr;
  }

  /* Typography */
  .section-title {
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 2rem;
  }

  .surgical-line.accent-line {
    width: 40px;
    height: 1px; /* Thinner line */
    background: var(--accent);
    margin-bottom: 2rem;
    opacity: 0.8;
  }

  .section-subtitle {
    font-size: 1.25rem;
    margin-bottom: 3rem;
    line-height: 1.6;
    max-width: 480px;
    font-weight: 400;
    color: var(--text-secondary);
  }

  /* Image Area */
  .image-wrapper {
    position: relative;
    padding: 0; /* No padding */
  }

  .image-frame {
    position: relative;
    /* Removed gradient border, kept simple shadow/glow if needed, or plainly clean */
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }

  .image-container {
    position: relative;
    overflow: hidden;
    background: var(--secondary);
    border-radius: 2px; /* Slight radius */
  }

  .image-container img {
    width: 100%;
    display: block;
    /* Removed heavy filters for natural professional look */
    filter: brightness(0.95);
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .image-overlay {
    /* Subtle overlay only */
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.1);
    pointer-events: none;
  }

  .reveal-section:hover img {
    transform: scale(1.02);
    filter: brightness(1);
  }

  @media (max-width: 1200px) {
    .grid {
      gap: 4rem;
    }
  }

  @media (max-width: 991px) {
    .grid {
      grid-template-columns: 1fr;
      text-align: left;
      gap: 4rem;
    }
    .reveal-section.reverse .grid {
      direction: ltr;
    }

    .image-wrapper {
      padding: 1rem;
    }
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
        }
      });
    },
    { threshold: 0.15 },
  );

  document.querySelectorAll(".reveal-section").forEach((section) => {
    observer.observe(section);
  });
</script>
