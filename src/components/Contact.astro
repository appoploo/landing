---
const contactMethods = [
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>`,
    label: "Phone",
    value: "+30 2616 008286",
    href: "tel:+302616008286",
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6l-10 7L2 6"/></svg>`,
    label: "Email",
    value: "info@appoploo.com",
    href: "mailto:info@appoploo.com",
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>`,
    label: "Office",
    value: "Stadiou Str. 26 504, Platani Rio, Greece",
    href: null,
  },
];
---

<section id="contact" class="contact">
  <div class="container">
    <div class="contact-layout">
      <div class="contact-info">
        <span class="section-label">Get in Touch</span>
        <h2 class="section-title">
          Let's Build<br />
          <strong>Together</strong>
        </h2>
        <p class="section-description">
          Ready to transform your maritime operations? Our team is here to
          discuss your requirements and craft tailored solutions.
        </p>

        <div class="contact-methods">
          {
            contactMethods.map((method) => (
              <div class="contact-method">
                <div class="method-icon" set:html={method.icon} />
                <div class="method-content">
                  <span class="method-label">{method.label}</span>
                  {method.href ? (
                    <a href={method.href} class="method-value">
                      {method.value}
                    </a>
                  ) : (
                    <span class="method-value">{method.value}</span>
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--primary); /* match global background */
    position: relative;
    padding-bottom: 6rem;
  }

  .contact-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 5rem;
    align-items: start;
  }

  /* Info Side */
  .section-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #ffffff;
    opacity: 0.8;
    margin-bottom: 1rem;
  }

  .section-title {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 1.5rem;
    line-height: 1.1;
  }

  .section-description {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 3rem;
  }

  .contact-methods {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .contact-method {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .method-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 10px;
    color: #ffffff;
    backdrop-filter: blur(10px);
    flex-shrink: 0;
  }

  .method-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .method-label {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-tertiary);
  }

  .method-value {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-primary);
    transition: color 0.2s var(--ease-out);
  }

  a.method-value:hover {
    color: var(--accent);
  }

  /* Card Side */
  .contact-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 20px;
    padding: 3rem;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
  }

  .card-header {
    margin-bottom: 2rem;
  }

  .card-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .card-subtitle {
    font-size: 0.9375rem;
    color: var(--text-tertiary);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .form-input {
    padding: 1rem 1.25rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 12px;
    color: #ffffff;
    font-family: inherit;
    font-size: 0.9375rem;
    transition: all 0.3s ease;
  }

  .form-input::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  .form-input:focus {
    outline: none;
    border-color: #ffffff;
    background: rgba(255, 255, 255, 0.1);
    box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.1);
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
  }

  .btn-submit {
    margin-top: 0.5rem;
    width: 100%;
  }

  @media (max-width: 1024px) {
    .contact-layout {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 600px) {
    .form-row {
      grid-template-columns: 1fr;
    }

    .contact-card {
      padding: 1.5rem;
    }
  }
</style>
