---
import Section from "./Section.astro";
---

<Section
  id="products"
  title="Appoploo Tracker"
  subtitle="The gold-standard in maritime fleet intelligence. Zero compromise on security or precision."
  image="/appoploo_tracker_1769691062345.png"
  glass={true}
>
  <div class="luxe-features">
    <div class="feature-item">
      <div class="feature-icon"></div>
      <h4 class="f-title">Encryption Core</h4>
      <p class="f-desc text-muted">
        Military-grade data protocols ensuring your fleet coordinates remain
        private.
      </p>
    </div>

    <div class="feature-item">
      <div class="feature-icon"></div>
      <h4 class="f-title">Dynamic Polling</h4>
      <p class="f-desc text-muted">
        Intelligent frequency scaling based on vessel activity and mission
        requirements.
      </p>
    </div>
  </div>

  <div class="metrics glass-panel">
    <div class="metric">
      <span class="val">99.9%</span>
      <span class="tag">UPTIME</span>
    </div>
    <div class="metric-divider"></div>
    <div class="metric">
      <span class="val">&lt;5M</span>
      <span class="tag">ACCURACY</span>
    </div>
  </div>
</Section>

<style>
  .luxe-features {
    display: grid;
    gap: 3rem;
    margin-bottom: 4rem;
  }

  .feature-item {
    position: relative;
    padding-left: 1.5rem;
    border-left: 1px solid var(--border);
    transition: all 0.3s ease;
  }

  .feature-item:hover {
    border-left-color: var(--accent);
  }

  .f-title {
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--white);
    margin-bottom: 0.5rem;
    font-family: "Inter", sans-serif;
  }

  .f-desc {
    font-size: 1rem;
    line-height: 1.6;
  }

  .metrics {
    padding: 2.5rem;
    display: flex;
    justify-content: space-around;
    align-items: center;
    border-radius: 2px;
  }

  .metric-divider {
    width: 1px;
    height: 40px;
    background: var(--border-strong);
  }

  .metric {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .val {
    font-size: 2.5rem;
    font-weight: 700;
    font-family: "Playfair Display", serif;
    color: var(--accent);
    line-height: 1;
  }

  .tag {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--text-muted);
  }
</style>
