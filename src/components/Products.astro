---
const products = [
  {
    id: "tracker",
    label: "Vessel Tracking",
    title: "Appoploo",
    titleStrong: "Tracker",
    tagline:
      "Real-time vessel tracking on a live map — voyage history, speed and battery telemetry for commercial and recreational fleets.",
    image: "/tracker-dashboard.webp",
    imageW: 1600,
    imageH: 823,
    imageAlt:
      "Appoploo Tracker dashboard showing live vessel positions on a map of Greece with speed, battery and position telemetry",
    url: "https://tracker.appoploo.com",
    features: [
      {
        title: "Precision live tracking",
        desc: "Pinpoint every vessel on a live chart, anywhere in the world.",
      },
      {
        title: "Voyage history & telemetry",
        desc: "Replay past routes and monitor speed, heading and battery in real time.",
      },
      {
        title: "Built for fleets",
        desc: "Unlimited users, all-inclusive plans and enterprise-grade security.",
      },
    ],
    metrics: [
      { value: "Real-time", label: "Live GPS" },
      { value: "Global", label: "Coverage" },
      { value: "256-bit", label: "Encryption" },
    ],
  },
  {
    id: "yms",
    label: "Yacht Management",
    title: "Appoploo",
    titleStrong: "YMS",
    tagline:
      "Run your whole operation from one dashboard — vessels, crew, bookings, expenses and maintenance. No spreadsheets.",
    image: "/yms-dashboard.webp",
    imageW: 1600,
    imageH: 956,
    imageAlt:
      "Appoploo YMS yacht-management dashboard with revenue, active vessels, bookings, maintenance alerts and fleet utilization",
    url: "https://yms.appoploo.com",
    features: [
      {
        title: "Fleet & crew operations",
        desc: "Vessel records, documents, crew contracts and team roles in one place.",
      },
      {
        title: "Bookings & revenue",
        desc: "Seasonal pricing, availability and a public booking page — revenue at a glance.",
      },
      {
        title: "Expenses & maintenance",
        desc: "Recurring costs, invoices and scheduled maintenance across the fleet.",
      },
    ],
    metrics: [
      { value: "End-to-end", label: "Ops Stack" },
      { value: "Public", label: "Booking Page" },
      { value: "Real-time", label: "GPS + Ops" },
    ],
  },
];
---

<section id="products" class="products">
  <div class="products-bg"></div>

  <div class="container">
    <div class="products-header fade-up">
      <span class="section-label">Our Products</span>
      <h2 class="section-title">
        One maritime stack.<br />
        <strong>Two purpose-built platforms.</strong>
      </h2>
      <p class="section-lead">
        The Appoploo stack covers the full operational spectrum — from
        real-time vessel visibility to end-to-end fleet operations.
      </p>
    </div>

    {
      products.map((product, idx) => (
        <article
          class={`product-row fade-up ${idx % 2 === 1 ? "reverse" : ""}`}
          data-product={product.id}
        >
          <div class="product-content">
            <span class="product-label">{product.label}</span>
            <h3 class="product-title">
              {product.title}
              <br />
              <strong>{product.titleStrong}</strong>
            </h3>
            <p class="product-tagline">{product.tagline}</p>

            <div class="features-list">
              {product.features.map((feature) => (
                <div class="feature-item">
                  <div class="feature-check">
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="3"
                    >
                      <path d="M20 6L9 17l-5-5" />
                    </svg>
                  </div>
                  <div class="feature-text">
                    <h4 class="feature-title">{feature.title}</h4>
                    <p class="feature-desc">{feature.desc}</p>
                  </div>
                </div>
              ))}
            </div>

            <a href={product.url} class="product-link" target="_blank" rel="noopener">
              <span>Visit {product.titleStrong}</span>
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </a>
          </div>

          <div class="product-visual">
            <div class="visual-frame">
              <div class="frame-glow" />
              <div class="frame-border" />
              <img
                src={product.image}
                alt={product.imageAlt}
                width={product.imageW}
                height={product.imageH}
                loading="lazy"
                decoding="async"
              />
            </div>

            <div class="metrics-bar">
              {product.metrics.map((metric, i) => (
                <>
                  {i > 0 && <div class="metric-divider" />}
                  <div class="metric">
                    <span class="metric-value">{metric.value}</span>
                    <span class="metric-label">{metric.label}</span>
                  </div>
                </>
              ))}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .products {
    background: var(--secondary);
    position: relative;
    overflow: hidden;
    padding: var(--section-padding) 0;
  }

  .products-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 90% 10%, rgba(255, 255, 255, 0.06), transparent 55%),
      radial-gradient(ellipse at 10% 90%, rgba(255, 255, 255, 0.04), transparent 60%);
    pointer-events: none;
  }

  .products-header {
    max-width: 760px;
    margin: 0 auto 6rem;
    text-align: center;
  }

  .section-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #ffffff;
    opacity: 0.75;
    margin-bottom: 1.25rem;
  }

  .section-title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
  }

  .section-title strong {
    font-weight: 800;
  }

  .section-lead {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* Product Row */
  .product-row {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(3rem, 7vw, 6rem);
    align-items: center;
    position: relative;
  }

  .product-row + .product-row {
    margin-top: clamp(6rem, 10vw, 9rem);
  }

  .product-row.reverse {
    grid-template-columns: 1.15fr 1fr;
  }

  .product-row.reverse .product-content {
    order: 2;
  }

  .product-row.reverse .product-visual {
    order: 1;
  }

  /* Content */
  .product-label {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.7);
    padding: 0.4rem 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.04);
    margin-bottom: 1.75rem;
  }

  .product-title {
    font-size: clamp(2rem, 4.5vw, 3rem);
    margin-bottom: 1.25rem;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .product-title strong {
    font-weight: 800;
  }

  .product-tagline {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 2.5rem;
    max-width: 520px;
  }

  .features-list {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    margin-bottom: 2.5rem;
  }

  .feature-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .feature-check {
    width: 26px;
    height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 6px;
    color: #ffffff;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .feature-title {
    font-size: 0.9375rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
    color: var(--text-primary);
  }

  .feature-desc {
    font-size: 0.875rem;
    color: var(--text-tertiary);
    line-height: 1.55;
  }

  .product-link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.85rem 1.5rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 100px;
    color: #ffffff;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    backdrop-filter: blur(12px);
    transition: all 0.3s var(--ease-out);
  }

  .product-link:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.35);
    transform: translateY(-2px);
  }

  .product-link svg {
    transition: transform 0.3s var(--ease-out);
  }

  .product-link:hover svg {
    transform: translate(2px, -2px);
  }

  /* Visual */
  .product-visual {
    position: relative;
  }

  .visual-frame {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
  }

  .frame-glow {
    position: absolute;
    inset: -40%;
    background: radial-gradient(
      circle at 50% 50%,
      rgba(255, 255, 255, 0.18),
      transparent 55%
    );
    pointer-events: none;
    z-index: 0;
  }

  .frame-border {
    position: absolute;
    inset: 0;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 14px;
    z-index: 2;
    pointer-events: none;
  }

  .visual-frame img {
    width: 100%;
    height: auto;
    display: block;
    position: relative;
    z-index: 1;
    filter: saturate(0.9) contrast(1.05);
    transition: filter 0.6s var(--ease-out);
  }

  .visual-frame:hover img {
    filter: saturate(1) contrast(1.1);
  }

  .metrics-bar {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.75rem;
    padding: 1.25rem 1.75rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 12px;
    margin: -1.75rem 2rem 0;
    position: relative;
    z-index: 3;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .metric {
    text-align: center;
    flex: 1;
  }

  .metric-value {
    display: block;
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.2;
  }

  .metric-label {
    font-size: 0.625rem;
    font-weight: 600;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .metric-divider {
    width: 1px;
    height: 28px;
    background: rgba(255, 255, 255, 0.2);
    flex-shrink: 0;
  }

  @media (max-width: 1024px) {
    .product-row,
    .product-row.reverse {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .product-row .product-content,
    .product-row.reverse .product-content {
      order: 1;
    }

    .product-row .product-visual,
    .product-row.reverse .product-visual {
      order: 0;
    }
  }

  @media (max-width: 600px) {
    .metrics-bar {
      flex-direction: column;
      gap: 0.85rem;
      margin-left: 0.5rem;
      margin-right: 0.5rem;
    }

    .metric-divider {
      width: 60px;
      height: 1px;
    }

    .products-header {
      margin-bottom: 4rem;
    }
  }
</style>

<script>
  const rows = document.querySelectorAll(".product-row");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
        }
      });
    },
    { threshold: 0.15 },
  );

  rows.forEach((row) => observer.observe(row));
</script>
