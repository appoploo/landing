---
const featured = {
  title: "Escape through Culture",
  subtitle: "digital escape game",
  image: "/escape.webp",
  description:
    "A research initiative combining Greek cultural heritage, digital technologies and gamifying practices like escape games. Gamified cultural experiences across Elefsina, Lesvos, Volos and Skiathos.",
  meta: [
    { label: "Program", value: "2020 — 2023" },
    { label: "Funded by", value: "EU / RIS3" },
    { label: "Category", value: "Cultural Heritage" },
  ],
  partners: [
    "Computer Technology Institute 'Diophantus'",
    "University of Thessaly",
  ],
};
---

<section id="research" class="research">
  <div class="research-bg"></div>

  <div class="container">
    <div class="research-header fade-up">
      <span class="section-label">R&D Initiative</span>
      <h2 class="section-title">
        Applied research &<br />
        <strong>serious games.</strong>
      </h2>
      <p class="section-lead">
        We build immersive, gamified 3D experiences — blending Greek cultural
        heritage with digital technology. Funded research, real deployments.
      </p>
    </div>

    <article class="featured-card fade-up">
      <div class="featured-visual">
        <img src={featured.image} alt={featured.title} loading="lazy" />
        <div class="featured-overlay"></div>
        <span class="featured-badge">Featured Project</span>
      </div>

      <div class="featured-content">
        <h3 class="featured-title">
          <strong>{featured.title}</strong>
          <span class="featured-subtitle">{featured.subtitle}</span>
        </h3>
        <p class="featured-desc">{featured.description}</p>

        <div class="featured-meta">
          {
            featured.meta.map((item) => (
              <div class="meta-item">
                <span class="meta-label">{item.label}</span>
                <span class="meta-value">{item.value}</span>
              </div>
            ))
          }
        </div>

        <div class="partners">
          <span class="partners-label">In Partnership With</span>
          <div class="partners-list">
            {featured.partners.map((p) => <span class="partner">{p}</span>)}
          </div>
        </div>
      </div>
    </article>

  </div>
</section>

<style>
  .research {
    background: var(--primary);
    position: relative;
    padding: var(--section-padding) 0;
    overflow: hidden;
  }

  .research-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 20% 0%, rgba(255, 255, 255, 0.06), transparent 50%),
      radial-gradient(ellipse at 80% 100%, rgba(255, 255, 255, 0.04), transparent 55%);
    pointer-events: none;
  }

  .research::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.15),
      transparent
    );
  }

  /* Header */
  .research-header {
    max-width: 760px;
    margin: 0 auto 5rem;
    text-align: center;
  }

  .section-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #ffffff;
    opacity: 0.75;
    margin-bottom: 1.25rem;
  }

  .section-title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
  }

  .section-title strong {
    font-weight: 800;
  }

  .section-lead {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* Featured Card */
  .featured-card {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 4rem;
    align-items: center;
    padding: 2rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    position: relative;
    overflow: hidden;
    backdrop-filter: blur(10px);
  }

  .featured-visual {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .featured-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(0.9) contrast(1.05);
    transition: transform 0.8s var(--ease-out);
  }

  .featured-card:hover .featured-visual img {
    transform: scale(1.04);
  }

  .featured-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 60%,
      rgba(58, 83, 125, 0.8)
    );
  }

  .featured-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.4rem 0.9rem;
    background: rgba(255, 255, 255, 0.95);
    color: var(--primary);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    border-radius: 100px;
    z-index: 2;
  }

  .featured-content {
    padding: 1rem 0;
  }

  .featured-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    line-height: 1.15;
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .featured-title strong {
    font-weight: 800;
  }

  .featured-subtitle {
    font-size: 0.95em;
    font-weight: 400;
    color: var(--text-secondary);
  }

  .featured-desc {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .featured-meta {
    display: flex;
    gap: 2.5rem;
    padding: 1.5rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .meta-label {
    font-size: 0.625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-tertiary);
  }

  .meta-value {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .partners {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .partners-label {
    font-size: 0.625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-tertiary);
  }

  .partners-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .partner {
    padding: 0.4rem 0.85rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 100px;
    font-size: 0.75rem;
    font-weight: 500;
    color: #ffffff;
    backdrop-filter: blur(10px);
  }

  /* Games Divider */
  .games-divider {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .games-divider::before,
  .games-divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.15),
      transparent
    );
  }

  .divider-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--text-tertiary);
    white-space: nowrap;
  }

  /* Games Grid */
  .games-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 1rem;
  }

  .game-card {
    position: relative;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.02));
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.45s var(--ease-out), border-color 0.45s var(--ease-out), box-shadow 0.45s var(--ease-out);
    display: flex;
    flex-direction: column;
  }

  .game-card::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 16px;
    padding: 1px;
    background: linear-gradient(
      140deg,
      rgba(255, 255, 255, 0.25),
      transparent 30%,
      transparent 70%,
      rgba(255, 255, 255, 0.08)
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    opacity: 0.6;
    transition: opacity 0.4s var(--ease-out);
  }

  .game-card:hover {
    transform: translateY(-6px);
    border-color: rgba(255, 255, 255, 0.22);
    box-shadow: 0 24px 48px -20px rgba(0, 0, 0, 0.45);
  }

  .game-card:hover::after {
    opacity: 1;
  }

  /* Visual */
  .game-visual {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.25);
  }

  .game-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.8s var(--ease-out), filter 0.6s var(--ease-out);
    filter: saturate(0.85) contrast(1.08) brightness(0.95);
  }

  .game-card:hover .game-visual img {
    transform: scale(1.08);
    filter: saturate(1.05) contrast(1.15) brightness(1);
  }

  .game-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(29, 42, 66, 0.15) 0%,
      transparent 35%,
      rgba(29, 42, 66, 0.35) 70%,
      rgba(29, 42, 66, 0.85) 100%
    );
    pointer-events: none;
    z-index: 1;
  }

  /* Thematic accent glow — blooms on hover */
  .game-accent {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.5s var(--ease-out);
    z-index: 1;
    mix-blend-mode: screen;
  }

  .game-card:hover .game-accent {
    opacity: 1;
  }

  .accent-flood {
    background: radial-gradient(circle at 30% 100%, rgba(96, 165, 250, 0.45), transparent 55%);
  }

  .accent-volcano {
    background: radial-gradient(circle at 30% 100%, rgba(251, 146, 60, 0.5), transparent 55%);
  }

  .accent-ranger {
    background: radial-gradient(circle at 30% 100%, rgba(74, 222, 128, 0.4), transparent 55%);
  }

  .accent-sos {
    background: radial-gradient(circle at 30% 100%, rgba(244, 114, 182, 0.45), transparent 55%);
  }

  /* Tags — per-theme color */
  .game-tag {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    padding: 0.32rem 0.75rem;
    background: rgba(0, 0, 0, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: #ffffff;
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    border-radius: 100px;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .game-tag::before {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 8px currentColor;
  }

  .tag-flood {
    color: #93c5fd;
  }

  .tag-volcano {
    color: #fb923c;
  }

  .tag-ranger {
    color: #86efac;
  }

  .tag-sos {
    color: #f9a8d4;
  }

  /* Play button — pill style */
  .game-play {
    position: absolute;
    bottom: 0.9rem;
    right: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.85rem 0.5rem 0.7rem;
    background: rgba(255, 255, 255, 0.96);
    color: var(--primary);
    border-radius: 100px;
    z-index: 3;
    transition: all 0.35s var(--ease-out);
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .game-play:hover {
    transform: translateY(-2px) scale(1.04);
    background: #ffffff;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
    color: var(--primary);
  }

  .play-label {
    line-height: 1;
  }

  .game-wip {
    position: absolute;
    bottom: 0.9rem;
    right: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.85rem;
    background: rgba(0, 0, 0, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    border-radius: 100px;
    color: rgba(255, 255, 255, 0.85);
    z-index: 3;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .wip-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #fbbf24;
    box-shadow: 0 0 8px #fbbf24;
    animation: pulse-dot 1.6s infinite ease-in-out;
  }

  @keyframes pulse-dot {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(0.85);
    }
  }

  /* Placeholder for games without screenshots */
  .game-placeholder {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .placeholder-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
  }

  .placeholder-icon {
    position: relative;
    z-index: 1;
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 16px;
    color: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(10px);
  }

  .placeholder-sos {
    background:
      radial-gradient(circle at 30% 20%, rgba(244, 114, 182, 0.35), transparent 50%),
      radial-gradient(circle at 70% 80%, rgba(129, 140, 248, 0.3), transparent 55%),
      linear-gradient(135deg, #3f2b5c 0%, #1e1b4b 100%);
  }

  /* Content */
  .game-content {
    padding: 1.05rem 1.1rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }

  .game-header {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .game-title {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .game-tagline {
    font-size: 0.6875rem;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 600;
  }

  .game-desc {
    font-size: 0.78rem;
    color: var(--text-secondary);
    line-height: 1.5;
    opacity: 0.82;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.34em; /* reserve 2 lines so every card aligns */
  }

  .game-footer {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.85rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .stack-chips {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.3rem;
    overflow: hidden;
    width: 100%;
  }

  .stack-chip {
    padding: 0.2rem 0.45rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    font-size: 0.5625rem;
    font-weight: 500;
    color: var(--text-tertiary);
    letter-spacing: 0.02em;
    font-family:
      "SF Mono", Monaco, "Cascadia Code", monospace;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .game-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.6875rem;
    font-weight: 700;
    color: #ffffff;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 0.35rem 0.7rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 100px;
    transition: all 0.3s var(--ease-out);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .game-link:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.35);
  }

  .game-link svg {
    transition: transform 0.3s var(--ease-out);
  }

  .game-link:hover svg {
    transform: translate(2px, -2px);
  }

  .game-status {
    font-size: 0.625rem;
    font-weight: 600;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  @media (max-width: 1024px) {
    .featured-card {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 1.25rem;
    }

    .featured-visual {
      aspect-ratio: 16 / 10;
    }
  }

  @media (max-width: 600px) {
    .research-header {
      margin-bottom: 3.5rem;
    }

    .featured-card {
      margin-bottom: 4rem;
    }

    .featured-meta {
      gap: 1.25rem;
    }

    .games-divider {
      gap: 1rem;
      margin-bottom: 2rem;
    }

    .divider-label {
      font-size: 0.6875rem;
      letter-spacing: 0.14em;
    }
  }
</style>

<script>
  const cards = document.querySelectorAll(".fade-up");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
        }
      });
    },
    { threshold: 0.1 },
  );

  cards.forEach((card) => observer.observe(card));
</script>
