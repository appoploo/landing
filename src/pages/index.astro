---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ServicesSection from "../components/Services.astro";
import ProductsSection from "../components/Products.astro";
import ResearchSection from "../components/Research.astro";
import ContactSection from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <Header />
  <main>
    <Hero />
    <ServicesSection />
    <ProductsSection />
    <ResearchSection />
    <ContactSection />
  </main>
  <Footer />
</Layout>

<style>
  main {
    overflow-x: hidden;
  }
</style>
