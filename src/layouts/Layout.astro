---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Appoploo | Maritime Intelligence & Engineering",
  description = "Appoploo engineers the digital backbone for the global fleet. We provide high-fidelity vessel tracking, bespoke software development, and strategic IT consulting.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/appoploo_hero_v2_1769691119605.png" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta
      property="twitter:image"
      content="/appoploo_hero_v2_1769691119605.png"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Appoploo",
        "url": "https://appoploo.com",
        "logo": "https://appoploo.com/logo.png",
        "sameAs": ["https://linkedin.com/company/appoploo"],
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+30-2616-008286",
          "contactType": "customer service",
          "email": "info@appoploo.com"
        },
        "description": "Appoploo engineers the digital backbone for the global fleet. High-fidelity vessel tracking and bespoke software."
      }
    </script>
  </head>
  <body class="loading">
    <main id="swup">
      <slot />
    </main>

    <script>
      // Smooth reveal on load
      window.addEventListener("load", () => {
        document.body.classList.remove("loading");
      });
    </script>

    <style is:global>
      body {
        opacity: 1;
        transition: opacity 0.8s cubic-bezier(0.23, 1, 0.32, 1);
      }

      body.loading {
        opacity: 0;
      }
    </style>
  </body>
</html>
