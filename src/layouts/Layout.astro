---
import "../styles/global.css";
import StructuredData from "../components/StructuredData.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  keywords?: string;
}

const {
  title = "Appoploo | Maritime Intelligence, Vessel Tracking & Yacht Management",
  description = "Appoploo engineers the digital backbone for the global fleet — real-time vessel tracking, yacht management software and bespoke maritime engineering. Based in Patras, Greece.",
  image = "/appoploo_hero_v2_1769691119605.png",
  keywords = "vessel tracking, yacht management software, fleet management, maritime software, marine GPS tracking, ναυτιλιακό λογισμικό, Greece, Patras",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <meta name="theme-color" content="#486492" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Appoploo" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />

    <!-- Geo / Local SEO — Patras, Western Greece -->
    <meta name="geo.region" content="GR-13" />
    <meta name="geo.placename" content="Patras, Greece" />
    <meta name="geo.position" content="38.2884;21.7886" />
    <meta name="ICBM" content="38.2884, 21.7886" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Appoploo" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:image:alt" content="Appoploo — maritime intelligence & engineering" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />
    <meta property="twitter:image:alt" content="Appoploo — maritime intelligence & engineering" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <StructuredData />
  </head>
  <body class="loading">
    <main id="swup">
      <slot />
    </main>

    <script>
      // Smooth reveal on load
      window.addEventListener("load", () => {
        document.body.classList.remove("loading");
      });
    </script>

    <style is:global>
      body {
        opacity: 1;
        transition: opacity 0.8s cubic-bezier(0.23, 1, 0.32, 1);
      }

      body.loading {
        opacity: 0;
      }
    </style>
  </body>
</html>
